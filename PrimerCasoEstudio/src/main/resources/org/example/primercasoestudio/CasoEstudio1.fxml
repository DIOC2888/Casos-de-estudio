<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.primercasoestudio.PrimerCasoEstudioController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Reserva concurrente de entradas" />

    <HBox spacing="20">
        <VBox spacing="5" style="-fx-border-color: gray; -fx-padding: 10;">
            <Label text="Disponibles" />
            <Label fx:id="lblDisponibles" style="-fx-font-size: 28px; -fx-font-weight: bold;" text="20" />
        </VBox>
        <VBox spacing="5" style="-fx-border-color: gray; -fx-padding: 10;">
            <Label text="Confirmadas" />
            <Label fx:id="lblConfirmadas" style="-fx-font-size: 28px; -fx-font-weight: bold;" text="0" textFill="#0fc712" />
        </VBox>
        <VBox spacing="5" style="-fx-border-color: gray; -fx-padding: 10;">
            <Label text="Rechazadas" />
            <Label fx:id="lblRechazadas" style="-fx-font-size: 28px; -fx-font-weight: bold;" text="0" textFill="#ef1010" />
        </VBox>

    </HBox>

    <Button onAction="#iniciarSimulacion" text="Iniciar simulación" />
    <Label fx:id="lblEstado" text="Listo para iniciar." />

    <TextArea fx:id="txtLog" editable="false" prefHeight="200" />
</VBox>
